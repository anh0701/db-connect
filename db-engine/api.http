### variable

@session = d2ea5180-c19b-45ee-9f11-c8befa4277be
@localhost = http://localhost:8080

### check backend app

GET {{localhost}}/ping

#### test connect db

POST {{localhost}}/connect/test
Content-Type: application/json

{
  "type": "POSTGRES",
  "host": "localhost",
  "port": 5432,
  "database": "postgres",
  "username": "postgres",
  "password": "123456"
}

### create session

POST {{localhost}}/connect/create
Content-Type: application/json

{
  "type": "POSTGRES",
  "host": "localhost",
  "port": 5432,
  "database": "postgres",
  "username": "postgres",
  "password": "123456"
}

### close session

DELETE {{localhost}}/connect/{{session}}

### get list sessions

GET {{localhost}}/connect/sessions

### query

POST {{localhost}}/query
Content-Type: application/json

# {
#   "sessionId": "{{session}}",
#   "sql": "create table users(id SERIAL, name varchar(100))"
# }

# {
#   "sessionId": "{{session}}",
#   "sql": "insert into users(name) values ('Alice')"
# }

{
  "sessionId": "{{session}}",
  "sql": "select * from public.users"
}

### schema
GET {{localhost}}/metadata/schemas/{{session}}

### get all table name

GET {{localhost}}/metadata/tables/{{session}}?schema=public

### get column of table

GET {{localhost}}/metadata/columns/{{session}}/schema/users

### saved connection list

GET {{localhost}}/saved-connections

### get by id saved connection

GET {{localhost}}/saved-connections/1

### save connection

POST {{localhost}}/saved-connections
Content-Type: application/json
Accept: application/json

{
    "name": "Local PostgreSQL",
    "databaseType": "POSTGRESQL",
    "host": "localhost",
    "port": 5432,
    "databaseName": "job",
    "username": "postgres"
}

###

GET {{localhost}}/settings

###

GET {{localhost}}/settings/save_connection

###

PUT {{localhost}}/settings/save_connection
Accept: application/json

{
    "value": "false"
}
